<% layout("Layouts/boilerplate") %>
<link rel="stylesheet" href="/public/CSS/listingForm.css">
<body>
    <section class="py-5 mt-12" style="background: linear-gradient(135deg, #e0e7ff, #f8fafc); min-height:100vh;">
        <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-12">
            <!-- Logo & Header -->
            <div class="text-center mb-4">
                <i class="fas fa-home fa-3x" style="color:#4f46e5;"></i>
                <h1 class="fw-bold mb-2 mt-3" style="color:#1f2937;">Update Your Property</h1>
                <p class="lead text-muted mb-4">Share updated property which helps to many buyers and renters...</p>
            </div>
            
            <!-- Listing Form Card -->
            <div class="card shadow border-0 rounded-3" style="backdrop-filter: blur(8px);">
                <div class="card-body p-4">
                <!-- Main Form -->
                <form action="" id="listingForm" method="post" enctype="multipart/form-data">

                    <!-- 1. Basic Info -->
                    <h4 class="fw-semibold mb-3" style="color:#1f2937;"><i class="fas fa-info-circle me-2" style="color:#4f46e5;"></i>Basic Info</h4>
                    <div class="mb-3">
                    <label class="form-label fw-semibold" for="title">Title *</label>
                    <input type="text" id="title" name="title" class="form-control" placeholder="Property Title" value="<%-listing.title%>" required>
                    </div>
                    <div class="mb-3">
                    <label class="form-label fw-semibold" for="description">Description *</label>
                    <textarea id="description" name="description" class="form-control" rows="3" placeholder="Describe your property" required><%-listing.description%></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="type">Type *</label>
                        <select id="type" name="type" class="form-select" required>
                        <option value="">Select property type</option>
                        <option value="Villa">Villa</option>
                        <option value="Apartment">Apartment</option>
                        <option value="Flat">Flat</option>
                        <option value="Plot">Plot</option>
                        <option value="Commercial">Commercial</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="size">Size *</label>
                        <input type="text" id="size" name="size" class="form-control" placeholder="e.g., 1800 sqft" value="<%-listing.size%>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="purpose">Purpose *</label>
                        <select id="purpose" name="purpose" class="form-select" required>
                        <option value="">Select Purpose</option>
                        <option value="For Sale" selected>For Sale</option>
                        <option value="For Rent" disabled>For Rent (comming soon...)</option>
                        </select>
                    </div>
                    

                    <!-- 2. Price & Location -->
                    <h4 class="fw-semibold mb-3 mt-4" style="color:#1f2937;"><i class="fas fa-map-marker-alt me-2" style="color:#4f46e5;"></i>Pricing & Location</h4>
                    <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="price">Price (₹) *</label>
                        <input type="number" id="price" name="price" class="form-control" min="0" placeholder="e.g., 5000000" value="<%-listing.price%>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="area">Area / Locality *</label>
                        <input type="text" id="area" name="area" class="form-control" placeholder="Locality or Area" value="<%-listing.area%>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="city">City *</label>
                        <input type="text" id="city" name="city" class="form-control" placeholder="City" value="<%-listing.city%>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="state">State *</label>
                        <select id="state" name="state" class="form-select" required>
                        <option value="">Select State</option>
                        <!-- All state options as before -->
                        <option value="" disabled selected>Select your state</option>
                        <option value="Andaman and Nicobar Islands">Andaman and Nicobar Islands</option>
                        <option value="Andhra Pradesh">Andhra Pradesh</option>
                        <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                        <option value="Assam">Assam</option>
                        <option value="Bihar">Bihar</option>
                        <option value="Chandigarh">Chandigarh</option>
                        <option value="Chhattisgarh">Chhattisgarh</option>
                        <option value="Dadra and Nagar Haveli and Daman and Diu">Dadra and Nagar Haveli and Daman and Diu</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Goa">Goa</option>
                        <option value="Gujarat">Gujarat</option>
                        <option value="Haryana">Haryana</option>
                        <option value="Himachal Pradesh">Himachal Pradesh</option>
                        <option value="Jammu and Kashmir">Jammu and Kashmir</option>
                        <option value="Jharkhand">Jharkhand</option>
                        <option value="Karnataka">Karnataka</option>
                        <option value="Kerala">Kerala</option>
                        <option value="Ladakh">Ladakh</option>
                        <option value="Lakshadweep">Lakshadweep</option>
                        <option value="Madhya Pradesh">Madhya Pradesh</option>
                        <option value="Maharashtra">Maharashtra</option>
                        <option value="Manipur">Manipur</option>
                        <option value="Meghalaya">Meghalaya</option>
                        <option value="Mizoram">Mizoram</option>
                        <option value="Nagaland">Nagaland</option>
                        <option value="Odisha">Odisha</option>
                        <option value="Puducherry">Puducherry</option>
                        <option value="Punjab">Punjab</option>
                        <option value="Rajasthan">Rajasthan</option>
                        <option value="Sikkim">Sikkim</option>
                        <option value="Tamil Nadu">Tamil Nadu</option>
                        <option value="Telangana">Telangana</option>
                        <option value="Tripura">Tripura</option>
                        <option value="Uttar Pradesh">Uttar Pradesh</option>
                        <option value="Uttarakhand">Uttarakhand</option>
                        <option value="West Bengal">West Bengal</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="pincode">Pincode *</label>
                        <input type="number" id="pincode" name="pincode" class="form-control" required min="100000" max="999999" value="<%-listing.pincode%>" placeholder="Pincode">
                    </div>
                    </div>

                    <!-- 3. Images Upload -->
                    <div class=" conatiner-fluid row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h4 class="fw-semibold mb-3 mt-4" style="color:#1f2937;"><i class="fas fa-images me-2" style="color:#4f46e5;"></i>Upload Photos</h4>
                            <div class="upload-area mb-3" onclick="document.getElementById('image').click()">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color:#9ca3af;"></i>
                                <h6 class="fw-semibold mb-1" style="color:#374151;">Drag & Drop or Click to Upload</h6>
                                <p class="small text-muted">Supported formats: JPG, PNG, WEBP</p>
                                <input type="file" id="image" name="image" accept="image/*"  class="d-none" multiple>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h4 class="fw-semibold mb-3 mt-4" style="color:#1f2937;"><i class="fas fa-eye me-2" style="color:#4f46e5;"></i>Preview</h4>
                            <div id="preview" class="d-flex flex-wrap gap-2 ms-5">
                                <% if (listing.image) { %>
                                    <div class="position-relative">
                                        <img src="<%=listing.image.url%>" width="40%" alt="Property Image" class="preview-img rounded">
                                    </div>
                                <% } else { %>
                                    <p class="text-muted">No image uploaded yet.</p>
                                <% } %>
                        </div>
                    </div>

                    <!-- 4. Buttons -->
                    <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-outline-secondary flex-fill">
                        <i class="fas fa-save me-2"></i>Save Draft
                    </button>
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="fas fa-rocket me-2"></i>Publish
                    </button>
                    </div>

                    <!-- Terms -->
                    <div class="mt-4 text-center small text-muted">
                    By posting, you agree to <a href="#" style="color:#4f46e5;">Terms</a> & <a href="#" style="color:#4f46e5;">Privacy</a>.
                    </div>
                
                </form>
                </div>
            </div>

            </div>
        </div>
        </div>
    </section>


    <script src="/public/JS/formValidation.js"></script>
</body>