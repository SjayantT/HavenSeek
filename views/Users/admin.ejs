<% layout("Layouts/boilerplate") %>
  <link rel="stylesheet" href="/public/CSS/admin.css" />
<body>
<!-- Navigation (Include your existing navbar here) -->
<!-- Admin Header Section -->
<section class="admin-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center">
                    <div class="admin-icon me-4">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div class="admin-info">
                        <h1 class="admin-name">Admin Dashboard</h1>
                        <p class="admin-role"><i class="fas fa-cog me-2"></i>Manage Properties & Agents</p>
                        <div class="admin-stats">
                            <span class="stat-item">
                                <i class="fas fa-home me-1"></i>
                                <strong id="totalListings"><%-listings.length%></strong> Active Listings
                            </span>
                            <span class="stat-item ms-4">
                                <i class="fas fa-check-circle me-1"></i>
                                <strong id="totalSold"><%-soldListings.length%></strong> Sold Properties
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="admin-actions">
                    <button class="btn btn-outline-primary me-2" onclick="location.reload()">
                        <i class="fas fa-sync me-2"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Admin Content -->
<section class="admin-content py-5">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="admin-sidebar">
                    <div class="sidebar-card">
                        <ul class="nav nav-pills flex-column" id="adminTabs">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="pill" href="/listings">
                                    <i class="fas fa-list me-2"></i>All Listings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="pill" href="#sold">
                                    <i class="fas fa-check-circle me-2"></i>Sold Properties
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="pill" href="#agents">
                                    <i class="fas fa-user-tie me-2"></i>Manage Agents
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div class="tab-content">
                    
                    <!-- Listings Tab -->
                    <div class="tab-pane fade show active" id="listings">
                        <div class="content-card">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="card-title">
                                    <i class="fas fa-list me-2 text-primary"></i>All Property Listings
                                </h5>
                                <input type="text" class="form-control" id="searchListings" placeholder="Search properties..." style="max-width: 250px;">
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Property</th>
                                            <th>Owner</th>
                                            <th>Price</th>
                                            <th>Type</th>
                                            <th>Agent</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="listingsBody">
                                        <!-- Listings will be rendered here by server -->
                                        <% for(listing of listings){ %>
                                            <tr data-prop-id="1">
                                            <td><strong><%-listing.title%></strong></td>
                                            <td><%-listing.owner.name%></td>
                                            <td><%-listing.price.toLocaleString("en-IN",{style:"currency", currency:"INR"})%></td>
                                            <td><span class="badge bg-light text-dark"><%-listing.type%></span></td>
                                            <td>
                                                <% if(listing.agent){ %>
                                                    <span class="agent-status assigned">
                                                    <i class="fas fa-user-check me-1"></i><%-listing.agent.name%>
                                                </span>
                                               <% } %>
                                               <% if(!listing.agent){ %>
                                                <span class="agent-status unassigned">
                                                    <i class="fas fa-user-slash me-1"></i>Unassigned
                                                </span>
                                                <% } %>
                                                
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <% if(!listing.agent){ %>
                                                        <button class="action-btn assign-btn" onclick="openAssignModal('<%-listing._id%>', '<%-listing.title%>')" title="Assign Agent">
                                                        <i class="fas fa-user-check me-1"></i>Assign
                                                        </button>
                                                   <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>
                                        
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Sold Properties Tab -->
                    <div class="tab-pane fade" id="sold">
                        <div class="content-card">
                            <h5 class="card-title">
                                <i class="fas fa-check-circle me-2 text-primary"></i>Sold Properties
                            </h5>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Property</th>
                                            <th>Owner</th>
                                            <th>Agent</th>
                                            <th>Sold Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for(let listing of soldListings) { %>
                                            <tr>
                                                <td><strong><%-listing.title%></strong></td>
                                                <td><%-listing.owner.name%></td>
                                                <td><%-listing.agent.name%></td>
                                                <td><%-listing.price.toLocaleString("en-IN",{style:"currency", currency:"INR"})%></td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Agents Tab -->
                    <!-- <div class="tab-pane fade" id="agents">
