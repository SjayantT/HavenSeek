<% layout("Layouts/boilerplate") %>
<body>
    <section class="d-flex align-items-center justify-content-center" style="min-height:90vh; ">
        <div class="card shadow-lg border-0" style="max-width:350px; width:100%; border-radius: 2rem;">
            <div class="card-header text-center bg-white border-0" style="border-top-left-radius:2rem; border-top-right-radius:2rem;">
            <div class="mb-3"><i class="fa-solid fa-right-to-bracket fa-2x text-indigo-600 "></i></div>
            <h3 class="fw-bolder mb-1" style="color:#4f46e5;">Log In to Admin Dashboard</h3>
            <p class="small text-muted">Access your account and explore exclusive properties.</p>
            </div>
            <div class="card-body px-5 py-4">
            <form action="/admin" class="needs-validation" method="post" novalidate>
                <!-- Username -->
                <div class="mb-3 input-group">
                <span class="input-group-text bg-white"><i class="fa fa-user text-indigo-600"></i></span>
                <input type="text" class="form-control" id="signupUsername" name="username" required placeholder="Username">
                <div class="invalid-feedback">
                    Please username!
                </div>
                </div>
                <!-- Password -->
                <div class="mb-3 input-group">
                <span class="input-group-text bg-white"><i class="fa fa-lock text-indigo-600"></i></span>
                <input type="password" class="form-control" id="signupPassword" name="password" required placeholder="Password">
                <div class="invalid-feedback">
                    Please enter valid password!
                </div>
                </div>
                <button type="submit" class="btn w-100 fw-bold text-white" style="background:#4f46e5;">Login</button>
            </form>
            </div>
        </div>
    </section>
</body>